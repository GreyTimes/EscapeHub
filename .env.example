# PostgreSQL development configuration

POSTGRES_DB=escapehub
POSTGRES_USER=escapehub
POSTGRES_PASSWORD=local_dev_change_this
POSTGRES_PORT=5432

# Backend API URL for Vite

VITE_API_BASE_URL=http://localhost:8080/api/v1

# Development-only user identifier
# Replace with the UUID of a seeded User when available.

VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Development-only mission used by the Solo / Team selector (#24)
# until the mission catalogue is connected.
# Replace with the UUIDs of a seeded Mission and Mission Version when available.

VITE_DEV_MISSION_ID=00000000-0000-4000-8000-000000000101
VITE_DEV_MISSION_VERSION_ID=00000000-0000-4000-8000-000000000201
